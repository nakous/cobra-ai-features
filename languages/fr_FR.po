msgstr "La feature \"Stripe Payments\" doit être activée pour utiliser cette intégration."

msgid "Enables the \"Credits\" product type in Stripe Payments. Create a \"Credits\" product to sell credit packs."
msgstr "Active le type de produit \"Crédits\" dans Stripe Payments. Créez un produit de type \"Crédits\" pour vendre des packs de crédits."

msgid "How to configure"
msgstr "Comment configurer"

msgid "Go to <strong>Stripe Payments &gt; Products</strong>"
msgstr "Allez dans <strong>Stripe Payments &gt; Products</strong>"

msgid "Create a new product with type <strong>\"Credits\"</strong>"
msgstr "Créez un nouveau produit avec le type <strong>\"Crédits\"</strong>"

msgid "Set the price, number of credits, and credit type"
msgstr "Renseignez le prix, le nombre de crédits et le type de crédit"

msgid "Publish the product — it will be available via the shortcode <code>[stripe_product id=\"...\"]</code>"
msgstr "Publiez le produit — il sera disponible via le shortcode <code>[stripe_product id=\"...\"]</code>"