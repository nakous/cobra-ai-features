msgid "Purchase confirmation — %s"
msgstr "Confirmation de votre achat — %s"

msgid "[%1$s] New order #%2$d — %3$s %4$s"
msgstr "[%1$s] Nouvelle commande #%2$d — %3$s %4$s"

msgid ""
"<p>A new order has been paid.</p>\n"
"<p><strong>Order:</strong> #%d<br>\n"
"<strong>Customer:</strong> %s (%s)<br>\n"
"<strong>Product:</strong> %s<br>\n"
"<strong>Amount:</strong> %s %s</p>"
msgstr ""
"<p>Une nouvelle commande a été payée.</p>\n"
"<p><strong>Commande :</strong> #%d<br>\n"
"<strong>Client :</strong> %s (%s)<br>\n"
"<strong>Produit :</strong> %s<br>\n"
"<strong>Montant :</strong> %s %s</p>"

msgid "Refund for your order #%1$d — %2$s"
msgstr "Remboursement de votre commande #%1$d — %2$s"

msgid ""
"<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\">\n"
"<h2 style=\"color:#0c5460;\">Refund processed</h2>\n"
"<p>Hello %1$s,</p>\n"
"<p>Your order <strong>#%2$d</strong> for <strong>%3$s %4$s</strong> has been refunded.</p>\n"
"<p>The amount will be credited to your payment method within a few business days.</p>\n"
"<p>Best regards,<br>%5$s</p>\n"
"</div>"
msgstr ""
"<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\">\n"
"<h2 style=\"color:#0c5460;\">Remboursement effectué</h2>\n"
"<p>Bonjour %1$s,</p>\n"
"<p>Votre commande <strong>#%2$d</strong> d'un montant de <strong>%3$s %4$s</strong> a été remboursée.</p>\n"
"<p>Le montant sera crédité sur votre moyen de paiement sous quelques jours ouvrables.</p>\n"
"<p>Cordialement,<br>%5$s</p>\n"
"</div>"

